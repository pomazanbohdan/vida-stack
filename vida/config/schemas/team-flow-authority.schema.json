{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vida.local/schemas/team-flow-authority.schema.json",
  "title": "VIDA TeamFlow authority selection and resolved projection",
  "type": "object",
  "anyOf": [
    { "$ref": "#/$defs/authoritySelection" },
    { "$ref": "#/$defs/authorityHeader" },
    { "$ref": "#/$defs/resolvedAuthority" },
    { "$ref": "#/$defs/sourceAuthorityCatalog" }
  ],
  "$defs": {
    "authoritySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_id",
        "team_profile_id",
        "default_flow_id",
        "projection_mode",
        "registry_identity_algorithm",
        "terminal_source",
        "edge_source",
        "command_resolution_mode",
        "approval_enforcement_mode",
        "alias_conflict_policy",
        "node_field_source_mode",
        "dispatch_alias_resolution_mode",
        "carrier_relation_mode",
        "profile_model_resolution_mode"
      ],
      "properties": {
        "schema_version": { "const": "team-flow-authority.v1" },
        "config_id": { "type": "string", "minLength": 1 },
        "team_profile_id": { "type": "string", "minLength": 1 },
        "default_flow_id": { "type": "string", "minLength": 1 },
        "projection_mode": { "enum": ["typed_fail_closed"] },
        "registry_identity_algorithm": { "enum": ["canonical_json_blake3_v1"] },
        "terminal_source": { "enum": ["config_only"] },
        "edge_source": { "enum": ["explicit_config_only"] },
        "command_resolution_mode": { "enum": ["registry_ref_only"] },
        "approval_enforcement_mode": { "enum": ["required"] },
        "alias_conflict_policy": { "enum": ["reject"] },
        "node_field_source_mode": { "enum": ["typed_exact_one"] },
        "dispatch_alias_resolution_mode": { "enum": ["registry_ref_exactly_one"] },
        "carrier_relation_mode": { "enum": ["distinct_from_executor_backend"] },
        "profile_model_resolution_mode": { "enum": ["registry_identity_ref"] }
      }
    },
    "sourceAuthorityCatalog": {
      "type": "object",
      "required": [
        "source_flow_fields",
        "source_flow_step_fields",
        "approval_policy_modes",
        "approval_policy_allowed_decisions"
      ],
      "properties": {
        "source_flow_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "flow_id",
              "id",
              "enabled",
              "default",
              "description",
              "flow_class",
              "work_item_bindings",
              "sequential",
              "allow_parallel_handoffs",
              "fail_closed_on_missing_step_contract",
              "lifecycle_hook_templates",
              "proof_gates",
              "resume_transitions",
              "rework_transitions",
              "adapter_projection",
              "adaptive_policy",
              "entry_node_id",
              "initial_node_id",
              "steps",
              "ordered_steps"
            ]
          }
        },
        "source_flow_step_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "node_id",
              "step_id",
              "role_id",
              "role",
              "runtime_role",
              "task_class",
              "task_classes",
              "packet_template_kind",
              "closure_class",
              "stage",
              "completion_blocker",
              "inclusion_rule",
              "included",
              "required",
              "next_node",
              "next",
              "dispatch_alias",
              "command_template",
              "command_ref",
              "command_mapping",
              "lifecycle_hook_templates",
              "carrier_constraints",
              "model_profile_constraints",
              "proof_gates",
              "evidence_requirements",
              "resume_transitions",
              "rework_transitions",
              "rework",
              "adapter_projection",
              "approval_policy",
              "requires_user_approval",
              "terminal",
              "terminal_closure",
              "closes_workflow",
              "lane_id",
              "dispatch_target"
            ]
          }
        },
        "approval_policy_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "user_review_required",
              "optional_user_review",
              "not_required"
            ]
          }
        },
        "approval_policy_allowed_decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["approved", "rework"]
          }
        }
      }
    },
    "authorityIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_blake3"],
      "properties": {
        "id": { "type": "string", "minLength": 66 },
        "content_blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profileAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team_role_id", "runtime_role", "task_class", "source_path"],
      "properties": {
        "team_role_id": { "type": "string", "minLength": 1 },
        "runtime_role": { "type": "string", "minLength": 1 },
        "task_class": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 }
      }
    },
    "selectedModelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "provider",
        "model_ref",
        "reasoning_effort",
        "selection_source"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "model_ref": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "selection_source": { "type": "string", "minLength": 1 }
      }
    },
    "commandMapping": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "required": ["command_id", "surface"],
      "properties": {
        "command_id": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "args": { "type": ["string", "array"], "items": { "type": "string" } },
        "description": { "type": "string" }
      }
    },
    "proofGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_outputs"],
      "properties": {
        "required_outputs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "runtimeAssignment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true,
      "not": {
        "anyOf": [
          { "required": ["executor_backend"] },
          { "required": ["backend_id"] },
          { "required": ["backend_class"] },
          { "required": ["required_backend_class"] }
        ]
      }
    },
    "carrierRelationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_kind", "source_path", "selected_id"],
      "properties": {
        "relation_kind": { "const": "carrier_catalog" },
        "source_path": { "type": "string", "minLength": 1 },
        "selected_id": { "type": "string", "minLength": 1 }
      }
    },
    "executorBackendRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_kind",
        "source_path",
        "selected_id",
        "backend_class",
        "required_backend_class"
      ],
      "properties": {
        "relation_kind": { "const": "executor_backend" },
        "source_path": { "type": "string", "minLength": 1 },
        "selected_id": { "type": "string", "minLength": 1 },
        "backend_class": { "type": "string", "minLength": 1 },
        "required_backend_class": { "type": "string", "minLength": 1 }
      }
    },
    "identityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "source_path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 }
      }
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_fields"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "lane_id",
        "dispatch_target",
        "dispatch_alias",
        "runtime_role",
        "task_class",
        "packet_template_kind",
        "closure_class",
        "stage",
        "completion_blocker",
        "inclusion_rule",
        "included",
        "required",
        "next_node",
        "evidence_requirements",
        "proof_gates",
        "command_ref",
        "command_mapping",
        "rework",
        "terminal",
        "profile_authority",
        "selected_model_profile",
        "requires_user_approval",
        "approval_policy",
        "lifecycle_hook_templates",
        "resume_transitions",
        "policy_diagnostics",
        "activation",
        "runtime_assignment",
        "carrier_runtime_assignment",
        "carrier_relation",
        "executor_backend_relation",
        "authority_identities",
        "execution_identity"
      ],
      "properties": {
        "node_id": { "type": "string", "minLength": 1 },
        "lane_id": { "type": "string", "minLength": 1 },
        "dispatch_target": { "type": "string", "minLength": 1 },
        "dispatch_alias": { "type": "string", "minLength": 1 },
        "runtime_role": { "type": "string", "minLength": 1 },
        "task_class": { "type": "string", "minLength": 1 },
        "packet_template_kind": { "type": "string", "minLength": 1 },
        "closure_class": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "completion_blocker": { "type": "string", "minLength": 1 },
        "inclusion_rule": {
          "enum": [
            "always",
            "never",
            "optional",
            "when_proof_required",
            "when_review_triggered",
            "when_architecture_triggered",
            "when_rework_required"
          ]
        },
        "included": { "type": "boolean" },
        "required": { "type": "boolean" },
        "next_node": { "type": ["string", "null"] },
        "evidence_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "proof_gates": { "$ref": "#/$defs/proofGates" },
        "command_ref": { "type": ["string", "null"] },
        "command_mapping": { "oneOf": [{ "$ref": "#/$defs/commandMapping" }, { "type": "null" }] },
        "rework": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets"],
          "properties": {
            "targets": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "terminal": { "type": "boolean" },
        "profile_authority": { "$ref": "#/$defs/profileAuthority" },
        "selected_model_profile": { "$ref": "#/$defs/selectedModelProfile" },
        "requires_user_approval": { "type": "boolean" },
        "approval_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "user_review_required",
                "optional_user_review",
                "not_required"
              ]
            },
            "prompt_template": { "type": "string", "minLength": 1 },
            "allowed_decisions": {
              "type": "array",
              "items": { "enum": ["approved", "rework"] },
              "uniqueItems": true
            }
          }
        },
        "lifecycle_hook_templates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resume_transitions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "policy_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "fallback_used", "fallback_fields"],
          "properties": {
            "source": { "const": "team_flow_authority.selected_config" },
            "fallback_used": { "const": false },
            "fallback_fields": { "type": "array", "maxItems": 0 }
          }
        },
        "activation": { "$ref": "#/$defs/runtimeAssignment" },
        "runtime_assignment": { "$ref": "#/$defs/runtimeAssignment" },
        "carrier_runtime_assignment": { "$ref": "#/$defs/runtimeAssignment" },
        "carrier_relation": {
          "$ref": "#/$defs/carrierRelationReference"
        },
        "executor_backend_relation": {
          "$ref": "#/$defs/executorBackendRelation"
        },
        "authority_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identityReference" }
        },
        "execution_identity": { "$ref": "#/$defs/executionIdentity" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": {
            "properties": {
              "evidence_requirements": { "minItems": 1 },
              "proof_gates": {
                "properties": { "required_outputs": { "minItems": 1 } }
              }
            }
          }
        },
        {
          "if": { "properties": { "terminal": { "const": true } }, "required": ["terminal"] },
          "then": { "properties": { "next_node": { "type": "null" } } },
          "else": { "properties": { "next_node": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "command_ref": { "type": "string" } }, "required": ["command_ref"] },
          "then": { "properties": { "command_mapping": { "$ref": "#/$defs/commandMapping" } } }
        },
        {
          "if": {
            "properties": { "requires_user_approval": { "const": true } },
            "required": ["requires_user_approval"]
          },
          "then": {
            "properties": {
              "approval_policy": {
                "required": ["mode", "prompt_template", "allowed_decisions"],
                "properties": {
                  "allowed_decisions": { "minItems": 1, "contains": { "const": "approved" } }
                }
              },
              "resume_transitions": {
                "minProperties": 1,
                "required": ["approved"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_policy": {
                "required": ["mode"]
              }
            },
            "required": ["approval_policy"]
          },
          "then": {
            "properties": {
              "approval_policy": {
                "required": ["allowed_decisions"],
                "properties": {
                  "allowed_decisions": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_policy": {
                "anyOf": [
                  { "required": ["prompt_template"] },
                  { "required": ["allowed_decisions"] }
                ]
              }
            },
            "required": ["approval_policy"]
          },
          "then": {
            "properties": {
              "approval_policy": {
                "required": ["mode"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "mode": { "const": "user_review_required" }
                },
                "required": ["mode"]
              }
            },
            "required": ["approval_policy"]
          },
          "then": {
            "properties": {
              "requires_user_approval": { "const": true },
              "approval_policy": {
                "required": ["prompt_template", "allowed_decisions"],
                "properties": {
                  "allowed_decisions": {
                    "contains": { "const": "approved" }
                  }
                }
              },
              "resume_transitions": {
                "required": ["approved"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "mode": { "const": "optional_user_review" }
                },
                "required": ["mode"]
              }
            },
            "required": ["approval_policy"]
          },
          "then": {
            "properties": {
              "requires_user_approval": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "approval_policy": {
                "properties": {
                  "mode": { "const": "not_required" }
                },
                "required": ["mode"]
              }
            },
            "required": ["approval_policy"]
          },
          "then": {
            "properties": {
              "requires_user_approval": { "const": false },
              "approval_policy": {
                "not": { "required": ["prompt_template"] }
              },
              "resume_transitions": {
                "not": { "required": ["approved"] }
              }
            }
          }
        }
      ]
    },
    "authorityHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "authority_id",
        "content_blake3",
        "config",
        "registries",
        "selected_config"
      ],
      "properties": {
        "schema_version": { "const": "team-flow-authority.v1" },
        "authority_id": { "type": "string", "minLength": 66 },
        "content_blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "config": { "$ref": "#/$defs/authorityIdentity" },
        "registries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roles",
            "skills",
            "profiles",
            "flows",
            "packs",
            "commands",
            "dispatch_aliases"
          ],
          "properties": {
            "roles": { "$ref": "#/$defs/authorityIdentity" },
            "skills": { "$ref": "#/$defs/authorityIdentity" },
            "profiles": { "$ref": "#/$defs/authorityIdentity" },
            "flows": { "$ref": "#/$defs/authorityIdentity" },
            "packs": { "$ref": "#/$defs/authorityIdentity" },
            "commands": { "$ref": "#/$defs/authorityIdentity" },
            "dispatch_aliases": { "$ref": "#/$defs/authorityIdentity" }
          }
        },
        "selected_config": { "$ref": "#/$defs/selectedConfig" },
        "source_of_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["options", "selection", "schema"],
          "properties": {
            "options": { "type": "string", "minLength": 1 },
            "selection": { "type": "string", "minLength": 1 },
            "schema": { "type": "string", "minLength": 1 }
          }
        },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
        "resolved_all_flow_payload": { "$ref": "#/$defs/resolvedAllFlowPayload" },
        "resolved_all_flow_payload_blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authority_source": { "$ref": "#/$defs/authoritySource" }
      },
      "allOf": [
        {
          "if": { "required": ["lanes"] },
          "then": {
            "required": [
              "resolved_all_flow_payload",
              "resolved_all_flow_payload_blake3",
              "authority_source"
            ]
          }
        }
      ]
    },
    "selectedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "config_id",
        "profile",
        "team_flow_enabled",
        "authority_selection",
        "registry_hash"
      ],
      "properties": {
        "schema_version": { "const": "team-flow-authority.v1" },
        "config_id": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "team_flow_enabled": { "type": "boolean", "default": true },
        "authority_selection": { "$ref": "#/$defs/authoritySelection" },
        "registry_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "flowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "default",
        "flow_class",
        "description",
        "work_item_bindings",
        "sequential",
        "allow_parallel_handoffs",
        "lifecycle_hook_templates",
        "proof_gates",
        "resume_transitions",
        "rework_transitions",
        "adapter_projection"
      ],
      "properties": {
        "enabled": { "type": ["boolean", "null"] },
        "default": { "type": ["boolean", "null"] },
        "flow_class": { "type": ["string", "null"], "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "work_item_bindings": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sequential": { "type": ["boolean", "null"] },
        "allow_parallel_handoffs": { "type": ["boolean", "null"] },
        "lifecycle_hook_templates": {
          "type": ["array", "null"],
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "proof_gates": {
          "oneOf": [{ "$ref": "#/$defs/proofGates" }, { "type": "null" }]
        },
        "resume_transitions": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            { "type": "null" }
          ]
        },
        "rework_transitions": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            { "type": "null" }
          ]
        },
        "adapter_projection": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        }
      }
    },
    "resolvedFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "flow_identity", "flow_policy", "entry_node_id", "lanes"],
      "properties": {
        "flow_id": { "type": "string", "minLength": 1 },
        "flow_identity": { "$ref": "#/$defs/identityReference" },
        "flow_policy": { "$ref": "#/$defs/flowPolicy" },
        "entry_node_id": { "type": "string", "minLength": 1 },
        "lanes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lane" } }
      }
    },
    "resolvedAllFlowPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "flow_count",
        "lane_count",
        "work_item_flow_bindings",
        "flows"
      ],
      "properties": {
        "schema_version": { "const": "team-flow-authority.v1" },
        "flow_count": { "type": "integer", "minimum": 1 },
        "lane_count": { "type": "integer", "minimum": 1 },
        "work_item_flow_bindings": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "flows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolvedFlow" }
        }
      }
    },
    "authoritySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload_path", "payload_blake3", "identity_phase"],
      "properties": {
        "kind": { "const": "resolved_all_flow_payload" },
        "payload_path": { "const": "team_flow_authority.resolved_all_flow_payload" },
        "payload_blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "identity_phase": { "const": "phase_2_persisted_payload" }
      }
    },
    "resolvedAuthority": {
      "allOf": [
