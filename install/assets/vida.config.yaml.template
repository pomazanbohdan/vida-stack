project:
  id: __PROJECT_ID__
  overlay_version: 1

project_bootstrap:
  enabled: true
  docs_root: __DOCS_ROOT__
  process_root: __PROCESS_ROOT__
  research_root: __RESEARCH_ROOT__
  readme_doc: __README_DOC__
  architecture_doc: __ARCHITECTURE_DOC__
  decisions_doc: __DECISIONS_DOC__
  environments_doc: __ENVIRONMENTS_DOC__
  project_operations_doc: __PROJECT_OPERATIONS_DOC__
  agent_system_doc: __AGENT_SYSTEM_DOC__
  allow_scaffold_missing: true
  require_launch_confirmation: true

language_policy:
  user_communication: __USER_COMMUNICATION__
  reasoning: __REASONING_LANGUAGE__
  documentation: __DOCUMENTATION_LANGUAGE__
  todo_protocol: __TODO_PROTOCOL_LANGUAGE__

taskflow:
  dispatch:
    enabled: false

host_environment:
  cli_system: __HOST_CLI_SYSTEM__
  bootstrap_carrier_system: codex
  host_carrier_schema_ref: vida/config/schemas/host-carrier.schema.json
  # Project overlays may replace the inline master contract with this
  # mutually-exclusive reference; keep the reference config-owned.
  # carrier_tier_contract_ref: __CARRIER_TIER_CONTRACT_REF__
  carrier_tier_contract:
    schema_version: host-carrier.v1
    canonical_field: carrier_tier
    legacy_compatibility_field: tier
    legacy_fallback: explicit_carrier_tier_or_legacy_tier
    unresolved_alias_policy: fail_closed_diagnostic
    tier_catalog:
      - tier_id: junior
        capability_class: bounded_write
        selection_order: 10
      - tier_id: middle
        capability_class: balanced_delivery
        selection_order: 20
      - tier_id: senior
        capability_class: independent_verification
        selection_order: 30
      - tier_id: architect
        capability_class: architecture_escalation
        selection_order: 40
  host_agent_bridge_contract:
    schema_version: 1
    selection_mode: configured_host_capability
    receipt_required: true
    no_adapter_policy: fail_closed_emit_request
    process_carrier_requires_explicit_backend: true
    supported_adapter_kinds:
      - codex_host_tools
      - codex_cli_subagents
      - claude_code_subagents
      - pi_sub_agent_plugin
      - vibe_kanban_agents
      - custom_host_agent_adapter
  codex:
    agents: &codex_agent_catalog
      junior:
        tier: junior
        carrier_tier: junior
        rate: 1
        reasoning_band: high
        model: gpt-5.6-luna
        model_reasoning_effort: high
        sandbox_mode: workspace-write
        default_model_profile: codex_gpt56_luna_high_write
        model_profiles:
          codex_gpt56_luna_high_write:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: high
            plan_mode_reasoning_effort: high
            sandbox_mode: workspace-write
            normalized_cost_units: 1
            pricing:
              price_source_kind: provider_catalog
              source_paths:
                - docs/process/codex-agent-configuration-guide.md
              freshness:
                required: false
                max_age_days: 30
                stale_price_policy: diagnostic_only_use_normalized_cost_units
                missing_price_policy: diagnostic_only_use_normalized_cost_units
                diagnostic_only: true
                enforced: false
            speed_tier: fast
            quality_tier: medium
            write_scope: workspace-write
            runtime_roles:
              - worker
            task_classes:
              - implementation
              - delivery_task
              - execution_block
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: worker
        runtime_roles:
          - worker
        task_classes:
          - implementation
          - delivery_task
          - execution_block
      middle:
        tier: middle
        carrier_tier: middle
        rate: 4
        reasoning_band: xhigh
        model: gpt-5.6-luna
        model_reasoning_effort: xhigh
        sandbox_mode: workspace-write
        default_model_profile: codex_gpt56_luna_xhigh_write
        model_profiles:
          codex_gpt56_luna_xhigh_write:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: xhigh
            plan_mode_reasoning_effort: xhigh
            sandbox_mode: workspace-write
            normalized_cost_units: 4
            speed_tier: fast
            quality_tier: medium
            write_scope: workspace-write
            runtime_roles:
              - business_analyst
              - pm
              - coach
              - worker
            task_classes:
              - research
              - analysis
              - specification
              - planning
              - coach
              - implementation
              - implementation_medium
              - delivery_task
              - execution_block
              - test_authoring
              - regression_test
              - refactor
              - architecture_cleanup
              - normalization
            readiness:
              mode: codex_profile
              required: true
          codex_gpt56_luna_xhigh_readonly:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: xhigh
            plan_mode_reasoning_effort: xhigh
            sandbox_mode: read-only
            normalized_cost_units: 4
            speed_tier: fast
            quality_tier: medium
            write_scope: read-only
            runtime_roles:
              - business_analyst
              - pm
              - coach
              - worker
            task_classes:
              - research
              - analysis
              - specification
              - planning
              - coach
              - implementation
              - implementation_medium
              - delivery_task
              - execution_block
              - test_authoring
              - regression_test
              - refactor
              - architecture_cleanup
              - normalization
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: coach
        runtime_roles:
          - business_analyst
          - pm
          - coach
          - worker
        task_classes:
          - research
          - analysis
          - specification
          - planning
          - coach
          - implementation
          - implementation_medium
          - delivery_task
          - execution_block
          - test_authoring
          - regression_test
          - refactor
          - architecture_cleanup
          - normalization
      senior:
        tier: senior
        carrier_tier: senior
        rate: 16
        reasoning_band: max
        model: gpt-5.6-luna
        model_reasoning_effort: max
        sandbox_mode: read-only
        default_model_profile: codex_gpt56_luna_max_review
        model_profiles:
          codex_gpt56_luna_max_review:
