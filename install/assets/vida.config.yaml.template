              - verifier
              - prover
            task_classes:
              - verification
              - review
              - quality_gate
              - release_readiness
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: verifier
        runtime_roles:
          - verifier
          - prover
        task_classes:
          - verification
          - review
          - quality_gate
          - release_readiness
      architect:
        tier: architect
        carrier_tier: architect
        rate: 48
        reasoning_band: high
        model: gpt-5.6-sol
        model_reasoning_effort: high
        sandbox_mode: read-only
        default_model_profile: codex_gpt56_sol_high_arch
        model_profiles:
          codex_gpt56_sol_high_arch:
