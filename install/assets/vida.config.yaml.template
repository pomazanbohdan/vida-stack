  systems:
    codex:
      enabled: true
      execution_class: internal
      executor_backend_relation:
        backend_id: internal_subagents
        required_backend_class: internal
      admissible_carrier_tiers:
        - junior
        - middle
        - senior
        - architect
      execution_boundary: parent_host_session
      dispatch_transport: host_tool_bridge
      receipt_mode: host_bridge_receipt
      materialization_mode: codex_toml_catalog_render
      template_root: .codex
      runtime_root: .codex
      app:
        enabled: true
        config_path: .codex/config.toml
        template_path: .codex/templates/codex-app.config.toml
        agents_dir: .codex/agents
        multi_agent: true
        internal_alias_projection: true
        platform_overrides:
          windows:
            shell_environment_policy:
              inherit: all
              exclude:
                - "*_KEY"
                - "*_SECRET"
                - "*_TOKEN"
                - "AWS_*"
                - "AZURE_*"
            agent_bootstrap_instructions: |
              VIDA command resolution for Windows Codex App:
              1. Before invoking `vida`, first try `Get-Command vida -ErrorAction SilentlyContinue`.
              2. If `vida` is not on PATH, resolve the installed production binary from `$env:LOCALAPPDATA\\vida-stack\\current\\bin\\vida.exe`.
              3. If `LOCALAPPDATA` is missing but `USERPROFILE` is present, resolve `$env:USERPROFILE\\AppData\\Local\\vida-stack\\current\\bin\\vida.exe`.
              4. When the installed production binary exists, prepend its parent directory to `$env:PATH` for the current process and invoke that binary or the refreshed `vida` command.
              5. Treat `target\\debug\\vida.exe` and `target\\release\\vida.exe` as repository diagnostics only; do not use them as the production VIDA runtime unless the parent packet explicitly asks for diagnostic fallback.
      legacy_cli:
        enabled: true
        template_path: .codex/templates/codex-cli.config.toml
        multi_agent_feature_required: true
      host_tool_bridge:
        adapter_kind: codex_host_tools
        adapter_capability_id: codex.multi_agent_v1
        invocation_mode: parent_host_tool_api
        dispatch_transport: host_tool_bridge
        receipt_mode: host_bridge_receipt
        operations:
          spawn: multi_agent_v1.spawn_agent
          wait: multi_agent_v1.wait_agent
          dispose: multi_agent_v1.close_agent
        dispose_policy: configured
        adapter_required: true
        no_adapter_policy: fail_closed_emit_request
        process_carrier_requires_explicit_backend: true
        fallback_process_carrier: codex_cli_exec
        adapter_command_schema_ref: vida/config/schemas/host_tool_bridge_adapter_command.schema.json
        adapter_command:
          executable: vida-host-bridge-adapter
          subcommands:
            - dispatch
          args:
            - --request
            - "{{request_path}}"
        adapter_command_contract:
          schema_version: 1
          placeholder_open: "{{"
          placeholder_close: "}}"
          request_placeholder: "{{request_path}}"
          placeholder_scope: args
          supported_fields:
            - executable
            - subcommands
            - args
          supported_capabilities:
            - parent_host_adapter_invocation
            - request_path_substitution
            - single_request_placeholder
          command_token_rules:
            executable: non_empty_single_line_scalar
            subcommands: non_empty_single_line_string_sequence
            args: non_empty_single_line_string_sequence
          adapter_command_states:
            - configured_valid
            - missing
            - invalid_missing_executable
            - invalid_empty_token
            - invalid_multiline_token
            - invalid_missing_placeholder
            - invalid_multiple_placeholders
            - invalid_mixed_route
            - not_applicable
          matrix_required_fields:
            - id
            - dispatch_transport
            - execution_boundary
            - adapter_command_state
            - expected_state
            - fail_closed
          admissible_route_command_combinations:
            - id: host_bridge_configured_valid
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: configured_valid
              expected_state: invoke_configured_adapter_command
              fail_closed: false
            - id: host_bridge_missing_adapter_command
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: missing
              expected_state: emit_host_bridge_request
              fail_closed: true
            - id: host_bridge_invalid_missing_executable
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: invalid_missing_executable
              expected_state: reject_invalid_adapter_command
              fail_closed: true
            - id: host_bridge_invalid_empty_token
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: invalid_empty_token
              expected_state: reject_invalid_adapter_command
              fail_closed: true
            - id: host_bridge_invalid_multiline_token
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: invalid_multiline_token
              expected_state: reject_invalid_adapter_command
              fail_closed: true
            - id: host_bridge_invalid_missing_placeholder
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: invalid_missing_placeholder
              expected_state: reject_invalid_adapter_command
              fail_closed: true
            - id: host_bridge_invalid_multiple_placeholders
              dispatch_transport: host_tool_bridge
              execution_boundary: parent_host_session
              adapter_command_state: invalid_multiple_placeholders
              expected_state: reject_invalid_adapter_command
              fail_closed: true
            - id: host_bridge_invalid_mixed_route
              dispatch_transport: host_tool_bridge
              execution_boundary: child_process
              adapter_command_state: invalid_mixed_route
              expected_state: reject_mixed_route
              fail_closed: true
            - id: explicit_process_carrier
              dispatch_transport: codex_cli_exec
              execution_boundary: child_process
              adapter_command_state: not_applicable
              expected_state: invoke_explicit_process_backend
              fail_closed: false
        request_dir: .vida/data/state/host-tool-bridge/requests
        result_dir: .vida/data/state/host-tool-bridge/results
        receipt_dir: .vida/data/state/host-tool-bridge/receipts
      carriers: *codex_agent_catalog
    qwen:
      enabled: true
      execution_class: external
      executor_backend_relation:
        backend_id: qwen_host_exec
