          proof_gates:
            required_outputs: [fixture_snapshot_or_smoke_evidence]
    hook_enabled_internal_agent_development:
      enabled: true
      description: Internal-agent development flow that requires host-tool bridge projection, hook telemetry, implementation proof, coach review, and independent verifier closure.
      flow_class: development
      work_item_bindings: [internal_agent_development]
      sequential: true
      allow_parallel_handoffs: true
      lifecycle_hook_templates: [command_timing_summary]
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - role_id: analyst
