          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [host_bridge_contract, agent_runtime_boundary]
        - role_id: developer
          runtime_role: worker
          task_class: implementation
          command_ref: agent-init-worker
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [changed_files, host_bridge_receipt_evidence]
        - role_id: coach
          runtime_role: coach
          task_class: coach
          command_ref: agent-init-coach
