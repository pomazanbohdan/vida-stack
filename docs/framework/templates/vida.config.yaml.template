          task_class: verification
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [verification_evidence]
    task_delivery_verified:
      enabled: true
      description: Standard bounded task flow that keeps generic task delivery shorter than release-style default_delivery while preserving scope analysis, implementation conformance review, and independent verification. Defect, runtime_defect, architecture, PR, and release_readiness work keep their specialized heavier flows.
      flow_class: development
      work_item_bindings:
        - task
      sequential: true
      allow_parallel_handoffs: true
      fail_closed_on_missing_step_contract: true
      lifecycle_hook_templates:
        - command_timing_summary
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          proof_gates:
            required_outputs: [bounded_problem_statement, acceptance_contract, owned_write_scope]
          lifecycle_hook_templates: [command_timing_summary]
        - role_id: developer
          runtime_role: worker
          task_class: implementation
          command_ref: agent-init-worker
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [changed_files, verification_notes]
        - role_id: coach
          runtime_role: coach
          task_class: coach
          command_ref: agent-init-coach
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [implementation_conformance_review, rework_or_approve_decision]
        - role_id: tester
          runtime_role: verifier
          task_class: verification
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [verification_evidence]
    default_delivery:
      enabled: true
      description: System analyst produces the detailed task brief, developer implements on the cheapest write lane, duplication reviewer checks architectural reuse/no duplication, final coach reviews the completed implementation, then tester/prover gates release closure.
      flow_class: development
      work_item_bindings:
        - epic
      sequential: true
      allow_parallel_handoffs: true
      fail_closed_on_missing_step_contract: true
      lifecycle_hook_templates:
        - command_timing_summary
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          proof_gates:
            required_outputs: [detailed_task_brief, acceptance_contract, owned_write_scope]
          requires_user_approval: true
          approval_policy:
            mode: user_review_required
            prompt_template: review_analysis_document_before_next_role
            allowed_decisions: [approved, rework]
          lifecycle_hook_templates: [command_timing_summary, approval_wait, approval_complete]
          resume_transitions:
            approved: developer
          rework_transitions:
            rework: analyst
        - role_id: developer
          runtime_role: worker
          task_class: implementation
          command_ref: agent-init-worker
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [changed_files, verification_notes]
        - role_id: duplication_reviewer
          runtime_role: verifier
          task_class: review
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [duplication_review_report]
        - role_id: coach
          runtime_role: coach
          task_class: coach
          command_ref: agent-init-coach
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [spec_conformance_review, rework_or_approve_decision]
        - role_id: tester
          runtime_role: verifier
          task_class: verification
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [verification_evidence]
        - role_id: prover
          runtime_role: prover
          task_class: quality_gate
          command_ref: agent-init-prover
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [closure_readiness_decision, proof_summary]
        - role_id: release_closure
          runtime_role: prover
          task_class: release_readiness
          command_ref: agent-init-prover
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [release_or_hold_decision, closure_receipt]

