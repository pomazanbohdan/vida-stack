project:
  id: __PROJECT_ID__
  overlay_version: 1

project_bootstrap:
  enabled: true
  docs_root: __DOCS_ROOT__
  process_root: __PROCESS_ROOT__
  research_root: __RESEARCH_ROOT__
  readme_doc: __README_DOC__
  architecture_doc: __ARCHITECTURE_DOC__
  decisions_doc: __DECISIONS_DOC__
  environments_doc: __ENVIRONMENTS_DOC__
  project_operations_doc: __PROJECT_OPERATIONS_DOC__
  agent_system_doc: __AGENT_SYSTEM_DOC__
  allow_scaffold_missing: true
  require_launch_confirmation: true

language_policy:
  user_communication: __USER_COMMUNICATION__
  reasoning: __REASONING_LANGUAGE__
  documentation: __DOCUMENTATION_LANGUAGE__
  todo_protocol: __TODO_PROTOCOL_LANGUAGE__

host_environment:
  cli_system: __HOST_CLI_SYSTEM__
  host_agent_bridge_contract:
    schema_version: 1
    selection_mode: configured_host_capability
    receipt_required: true
    no_adapter_policy: fail_closed_emit_request
    process_carrier_requires_explicit_backend: true
    supported_adapter_kinds:
      - codex_host_tools
      - codex_cli_subagents
      - claude_code_subagents
      - pi_sub_agent_plugin
      - vibe_kanban_agents
      - custom_host_agent_adapter
  codex:
    agents: &codex_agent_catalog
      junior:
        tier: junior
        rate: 1
        reasoning_band: high
        model: gpt-5.6-luna
        model_reasoning_effort: high
        sandbox_mode: workspace-write
        default_model_profile: codex_gpt56_luna_high_write
        model_profiles:
          codex_gpt56_luna_high_write:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: high
            plan_mode_reasoning_effort: high
            sandbox_mode: workspace-write
            normalized_cost_units: 1
            pricing:
              price_source_kind: provider_catalog
              source_paths:
                - docs/process/codex-agent-configuration-guide.md
              freshness:
                required: false
                max_age_days: 30
                stale_price_policy: diagnostic_only_use_normalized_cost_units
                missing_price_policy: diagnostic_only_use_normalized_cost_units
                diagnostic_only: true
                enforced: false
            speed_tier: fast
            quality_tier: medium
            write_scope: workspace-write
            runtime_roles:
              - worker
            task_classes:
              - implementation
              - delivery_task
              - execution_block
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: worker
        runtime_roles:
          - worker
        task_classes:
          - implementation
          - delivery_task
          - execution_block
      middle:
        tier: middle
        rate: 4
        reasoning_band: xhigh
        model: gpt-5.6-luna
        model_reasoning_effort: xhigh
        sandbox_mode: workspace-write
        default_model_profile: codex_gpt56_luna_xhigh_write
        model_profiles:
          codex_gpt56_luna_xhigh_write:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: xhigh
            plan_mode_reasoning_effort: xhigh
            sandbox_mode: workspace-write
            normalized_cost_units: 4
            speed_tier: fast
            quality_tier: medium
            write_scope: workspace-write
            runtime_roles:
              - business_analyst
              - pm
              - coach
              - worker
            task_classes:
              - research
              - analysis
              - specification
              - planning
              - coach
              - implementation_medium
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: coach
        runtime_roles:
          - business_analyst
          - pm
          - coach
          - worker
        task_classes:
          - research
          - analysis
          - specification
          - planning
          - coach
          - implementation_medium
      senior:
        tier: senior
        rate: 16
        reasoning_band: max
        model: gpt-5.6-luna
        model_reasoning_effort: max
        sandbox_mode: read-only
        default_model_profile: codex_gpt56_luna_max_readonly
        model_profiles:
          codex_gpt56_luna_max_readonly:
            provider: openai-codex
            model_ref: gpt-5.6-luna
            reasoning_effort: max
            plan_mode_reasoning_effort: max
            sandbox_mode: read-only
            normalized_cost_units: 16
            speed_tier: medium
            quality_tier: high
            write_scope: read-only
            runtime_roles:
              - verifier
              - prover
            task_classes:
              - verification
              - review
              - quality_gate
              - release_readiness
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: verifier
        runtime_roles:
          - verifier
          - prover
        task_classes:
          - verification
          - review
          - quality_gate
          - release_readiness
      architect:
        tier: architect
        rate: 48
        reasoning_band: medium
        model: gpt-5.6-sol
        model_reasoning_effort: medium
        sandbox_mode: read-only
        default_model_profile: codex_gpt56_sol_medium_arch
        model_profiles:
          codex_gpt56_sol_medium_arch:
            provider: openai-codex
            model_ref: gpt-5.6-sol
            reasoning_effort: medium
            plan_mode_reasoning_effort: medium
            sandbox_mode: read-only
            normalized_cost_units: 48
            speed_tier: medium
            quality_tier: very_high
            write_scope: read-only
            runtime_roles:
              - solution_architect
            task_classes:
              - hard_escalation
              - architecture
              - execution_preparation
              - meta_analysis
            readiness:
              mode: codex_profile
              required: true
        default_runtime_role: solution_architect
        runtime_roles:
          - solution_architect
        task_classes:
          - architecture
          - execution_preparation
          - hard_escalation
          - meta_analysis
  systems:
    codex:
      enabled: true
      execution_class: internal
      execution_boundary: parent_host_session
      dispatch_transport: host_tool_bridge
      receipt_mode: host_bridge_receipt
      materialization_mode: codex_toml_catalog_render
      template_root: .codex
      runtime_root: .codex
      app:
        enabled: true
        config_path: .codex/config.toml
        template_path: .codex/templates/codex-app.config.toml
        agents_dir: .codex/agents
        multi_agent: true
        internal_alias_projection: true
        platform_overrides:
          windows:
            shell_environment_policy:
              inherit: all
              exclude:
                - "*_KEY"
                - "*_SECRET"
                - "*_TOKEN"
                - "AWS_*"
                - "AZURE_*"
            agent_bootstrap_instructions: |
              VIDA command resolution for Windows Codex App:
              1. Before invoking `vida`, first try `Get-Command vida -ErrorAction SilentlyContinue`.
              2. If `vida` is not on PATH, resolve the installed production binary from `$env:LOCALAPPDATA\\vida-stack\\current\\bin\\vida.exe`.
              3. If `LOCALAPPDATA` is missing but `USERPROFILE` is present, resolve `$env:USERPROFILE\\AppData\\Local\\vida-stack\\current\\bin\\vida.exe`.
              4. When the installed production binary exists, prepend its parent directory to `$env:PATH` for the current process and invoke that binary or the refreshed `vida` command.
              5. Treat `target\\debug\\vida.exe` and `target\\release\\vida.exe` as repository diagnostics only; do not use them as the production VIDA runtime unless the parent packet explicitly asks for diagnostic fallback.
      legacy_cli:
        enabled: true
        template_path: .codex/templates/codex-cli.config.toml
        multi_agent_feature_required: true
      host_tool_bridge:
        adapter_kind: codex_host_tools
        adapter_capability_id: codex.multi_agent_v1
        invocation_mode: parent_host_tool_api
        dispatch_transport: host_tool_bridge
        receipt_mode: host_bridge_receipt
        operations:
          spawn: multi_agent_v1.spawn_agent
          wait: multi_agent_v1.wait_agent
          dispose: multi_agent_v1.close_agent
        dispose_policy: configured
        adapter_required: true
        no_adapter_policy: fail_closed_emit_request
        process_carrier_requires_explicit_backend: true
        fallback_process_carrier: codex_cli_exec
        request_dir: .vida/data/state/host-tool-bridge/requests
        result_dir: .vida/data/state/host-tool-bridge/results
        receipt_dir: .vida/data/state/host-tool-bridge/receipts
      carriers: *codex_agent_catalog
    qwen:
      enabled: true
      execution_class: external
      materialization_mode: copy_tree_only
      template_root: .qwen
      runtime_root: .qwen
      carriers:
        qwen-primary:
          tier: qwen
          rate: 4
          reasoning_band: medium
          default_runtime_role: worker
          runtime_roles:
            - worker
          task_classes:
            - implementation
            - research
    hermes:
      enabled: false
      execution_class: external
      materialization_mode: copy_tree_only
      template_root: .hermes
      runtime_root: .hermes
      carriers:
        hermes-primary:
          tier: hermes
          rate: 4
          reasoning_band: medium
          default_runtime_role: worker
          runtime_roles:
            - worker
          task_classes:
            - specification
            - planning
    pi:
      enabled: false
      execution_class: external
      materialization_mode: pi_agent_projection_render
      template_root: .pi
      runtime_root: .pi
      authority: config_projection_only
      source_of_truth: vida.config.yaml
      app:
        enabled: false
        settings_path: .pi/settings.json
        agents_dir: .pi/agents
        chains_dir: .pi/chains
        internal_agent_projection: true
        projection_owner: vida
        local_files_are_authority: false
      dispatch:
        command: vida-pi-agent
        adapter_command: vida-pi-agent
        provider_command: pi
        static_args:
          - --mode
          - rpc
        model_flag: --model
        thinking_level_flag: --thinking-level
        workdir_flag: --workdir
        output_mode: vida_result_json
        prompt_mode: stdin
        one_process_per_dispatch: true
        session_policy: no_long_lived_session
      carriers:
        pi-primary:
          tier: pi
          rate: 4
          reasoning_band: medium
          default_runtime_role: worker
          runtime_roles:
            - worker
            - business_analyst
            - coach
            - verifier
          task_classes:
            - implementation
            - delivery_task
            - execution_block
            - specification
            - planning
            - analysis
            - review
            - coach
            - verification
          authority: config_projection_only

protocol_activation:
  agent_system: true

agent_extensions:
  enabled: false
  worktree_root: .worktrees
  map_doc: .vida/project/agent-extensions/index.md
  registries:
    roles: .vida/project/agent-extensions/roles.yaml
    skills: .vida/project/agent-extensions/skills.yaml
    profiles: .vida/project/agent-extensions/profiles.yaml
    flows: .vida/project/agent-extensions/flows.yaml
    packs: .vida/project/agent-extensions/packs.yaml
    commands: .vida/project/agent-extensions/commands.yaml
    dispatch_aliases: .vida/project/agent-extensions/dispatch-aliases.yaml
    hook_templates: .vida/project/agent-extensions/hook-templates.yaml
  enabled_framework_roles:
    - orchestrator
    - worker
    - business_analyst
    - pm
    - coach
    - solution_architect
    - verifier
    - prover
  enabled_standard_flow_sets:
    - minimal
  enabled_project_roles: []
  enabled_project_skills: []
  enabled_shared_skills: []
  enabled_project_profiles: []
  enabled_project_flows: []
  enabled_hook_templates:
    - command_timing_summary
    - approval_wait
    - approval_complete
  default_flow_set: minimal
  role_selection:
    mode: auto
    fallback_role: orchestrator
    conversation_modes:
      scope_discussion:
        enabled: true
        role: business_analyst
        single_task_only: true
        tracked_flow_entry: spec-pack
        allow_freeform_chat: true
      pbi_discussion:
        enabled: true
        role: pm
        single_task_only: true
        tracked_flow_entry: work-pool-pack
        allow_freeform_chat: true
  validation:
    require_registry_files: true
    require_unique_ids: true
    require_framework_role_compatibility: true
    require_skill_role_compatibility: true
    require_profile_resolution: true
    require_flow_resolution: true
    fail_closed_on_validation_error: true

dev_team:
  enabled: true
  contract_doc: docs/process/team-development-and-orchestration-protocol.md
  preserve_existing_agent_extensions: true
  preserve_existing_flow_sets: true
  default_flow_id: task_delivery_verified
  work_item_flow_bindings:
    epic: default_delivery
    defect: defect_repair_verified
    runtime_defect: runtime_defect_remediation
    pull_request: pr_processing_team
    pr_repair: pr_processing_team
    architecture: architecture_design
    release_readiness: release_readiness_gate
    service_tui: service_tui_orchestration
    internal_agent_development: hook_enabled_internal_agent_development
    task: task_delivery_verified
    debug: debug_fast
  validation:
    require_role_contracts: true
    require_flow_definitions: true
    require_runtime_role_binding: true
    require_task_class_binding: true
    require_default_carrier_binding: true
    require_handoff_contracts: true
    require_ordered_closure_flow: true
    fail_closed_on_validation_error: true
  roles:
    analyst:
      runtime_role: business_analyst
      task_classes:
        - specification
        - planning
      packet_template_kind: delivery_task_packet
      closure_class: law
      stage: design_gate
      completion_blocker: pending_specification_evidence
      inclusion_rule: always
      default_carrier: middle
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: xhigh
      cost_policy:
        budget_units: 4
        selection_rule: cheapest_eligible_specification_carrier
      handoff:
        next_role: developer
        required_outputs:
          - detailed_task_brief
          - architectural_context
          - bounded_problem_statement
          - acceptance_contract
          - owned_write_scope
          - stop_rules
          - duplication_risk_map
        fail_closed_on_missing_handoff: true
    architect:
      runtime_role: solution_architect
      task_classes:
        - architecture
        - execution_preparation
      packet_template_kind: escalation_packet
      closure_class: refactor
      stage: execution
      completion_blocker: pending_execution_preparation_evidence
      inclusion_rule: always
      default_carrier: architect
      default_model: gpt-5.6-sol
      default_model_reasoning_effort: medium
      cost_policy:
        budget_units: 16
        selection_rule: high_architecture_carrier_for_execution_preparation
      handoff:
        next_role: developer
        required_outputs:
          - implementation_plan
          - owned_write_scope
          - architecture_decisions
          - explicit_blockers
        fail_closed_on_missing_handoff: true
    developer:
      runtime_role: worker
      task_classes:
        - implementation
        - delivery_task
        - execution_block
      packet_template_kind: delivery_task_packet
      closure_class: implementation
      stage: execution
      completion_blocker: pending_implementation_evidence
      inclusion_rule: always
      default_carrier: junior
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: high
      cost_policy:
        budget_units: 1
        fallback_carrier: middle
        selection_rule: cheapest_eligible_write_carrier
      handoff:
        next_role: duplication_reviewer
        required_outputs:
          - changed_files
          - verification_notes
          - residual_risks
          - explicit_blockers
        fail_closed_on_missing_handoff: true
    duplication_reviewer:
      runtime_role: verifier
      task_classes:
        - review
        - verification
        - quality_gate
      packet_template_kind: coach_review_packet
      closure_class: proof
      stage: execution
      completion_blocker: pending_review_clean_evidence
      inclusion_rule: always
      default_carrier: senior
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: max
      cost_policy:
        budget_units: 16
        selection_rule: independent_duplication_and_architecture_reuse_review
      review_contract:
        purpose: Confirm the implementation is architectural and integrated, reuses existing framework/runtime contracts, and does not duplicate code, config semantics, taskflow projections, or operator surfaces.
        required_checks:
          - shared_contract_reuse
          - duplicated_logic_scan
          - duplicated_config_schema_scan
          - existing_helper_reuse
          - architecture_boundary_integrity
          - no_dead_code_or_unwired_helpers
        fail_closed_on_duplication: true
      handoff:
        next_role: coach
        required_outputs:
          - duplication_review_report
          - reused_contracts
          - duplicate_risks
          - required_rework_or_clearance
        fail_closed_on_missing_handoff: true
    coach:
      runtime_role: coach
      task_classes:
        - coach
        - review
      packet_template_kind: coach_review_packet
      closure_class: proof
      stage: execution
      completion_blocker: pending_review_clean_evidence
      inclusion_rule: always
      default_carrier: middle
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: xhigh
      cost_policy:
        budget_units: 4
        selection_rule: final_spec_conformance_review_after_duplication_clearance
      handoff:
        next_role: tester
        required_outputs:
          - final_implementation_review
          - spec_conformance_review
          - rework_or_approve_decision
          - unresolved_risks
        fail_closed_on_missing_handoff: true
    tester:
      runtime_role: verifier
      task_classes:
        - verification
        - review
        - quality_gate
      packet_template_kind: verifier_proof_packet
      closure_class: proof
      stage: execution
      completion_blocker: pending_verification_evidence
      inclusion_rule: always
      default_carrier: senior
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: max
      cost_policy:
        budget_units: 16
        selection_rule: independent_verification_before_closure
      handoff:
        next_role: prover
        required_outputs:
          - verification_evidence
          - failing_or_passing_checks
          - residual_risks
        fail_closed_on_missing_handoff: true
    prover:
      runtime_role: prover
      task_classes:
        - verification
        - quality_gate
        - release_readiness
      packet_template_kind: verifier_proof_packet
      closure_class: proof
      stage: execution
      completion_blocker: pending_verification_evidence
      inclusion_rule: always
      default_carrier: senior
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: max
      cost_policy:
        budget_units: 16
        selection_rule: proof_strength_before_release
      handoff:
        next_role: release_closure
        required_outputs:
          - closure_readiness_decision
          - proof_summary
          - release_risks
        fail_closed_on_missing_handoff: true
    release_closure:
      runtime_role: prover
      task_classes:
        - release_readiness
        - quality_gate
      packet_template_kind: verifier_proof_packet
      closure_class: proof
      stage: execution
      completion_blocker: pending_verification_evidence
      inclusion_rule: always
      default_carrier: senior
      default_model: gpt-5.6-luna
      default_model_reasoning_effort: max
      cost_policy:
        budget_units: 16
        selection_rule: fail_closed_until_release_receipt
      handoff:
        next_role: terminal_closure
        required_outputs:
          - release_or_hold_decision
          - closure_receipt
          - follow_up_actions
        fail_closed_on_missing_handoff: true
  flows:
    debug_fast:
      enabled: true
      description: Short diagnostic flow for read-heavy debug or route validation where implementation is not yet authorized.
      flow_class: development
      work_item_bindings:
        - debug
      sequential: true
      allow_parallel_handoffs: true
      lifecycle_hook_templates:
        - command_timing_summary
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [bounded_problem_statement, explicit_blockers]
    defect_repair_verified:
      enabled: true
      description: Defect-oriented verified flow with analysis, implementation, coach, verifier, and proof closure.
      flow_class: development
      work_item_bindings:
        - defect
      sequential: true
      allow_parallel_handoffs: true
      lifecycle_hook_templates:
        - command_timing_summary
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [bounded_problem_statement, acceptance_contract]
        - role_id: developer
          runtime_role: worker
          task_class: implementation
          command_ref: agent-init-worker
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [changed_files, verification_notes]
        - role_id: coach
          runtime_role: coach
          task_class: coach
          command_ref: agent-init-coach
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [spec_conformance_review, rework_or_approve_decision]
        - role_id: tester
          runtime_role: verifier
          task_class: verification
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [verification_evidence]
    pr_processing_team:
      enabled: true
      description: Dedicated pull-request processing team that inventories PRs, integrates or closes the change, performs consolidated source/CI/duplication proof, then records final disposition.
      flow_class: development
      work_item_bindings:
        - pull_request
        - pr_repair
      sequential: true
      allow_parallel_handoffs: true
      fail_closed_on_missing_step_contract: true
      lifecycle_hook_templates:
        - command_timing_summary
      team_contract:
        team_id: pr_processing_team
        command_surface: vida agent dispatch-next --dev-team --current-task-id "{{task_id}}" --json
        intended_work_items:
          - pull_request
          - pr_repair
        merge_policy: four_role_integrate_or_close_with_receipt_backed_proof
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - step_id: pr-intake
          role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [pr_inventory, changed_scope_map, ci_review_snapshot, mergeability_matrix, recommended_disposition, owned_read_scope]
        - step_id: pr-integrate-or-close
          role_id: developer
          runtime_role: worker
          task_class: implementation
          command_ref: agent-init-worker
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [changed_files_or_close_plan, conflict_resolution_notes, verification_notes]
        - step_id: pr-review-and-proof
          role_id: tester
          runtime_role: verifier
          task_class: verification
          command_ref: agent-init-verifier
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [source_fidelity_review, duplication_review_report, post_integration_verification_evidence, failing_or_passing_checks, residual_risks]
        - step_id: pr-final-disposition
          role_id: prover
          runtime_role: prover
          task_class: release_readiness
          command_ref: agent-init-prover
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [final_pr_disposition, proof_summary, follow_up_actions]
    pr_repair_verified:
      enabled: true
      description: Legacy pull-request repair flow retained for compatibility. New pull_request and pr_repair work routes through pr_processing_team.
      flow_class: development
      work_item_bindings: [pull_request, pr_repair]
      sequential: true
      allow_parallel_handoffs: true
      lifecycle_hook_templates: [command_timing_summary]
      adapter_projection:
        host_agent_bridge_contract: required
        process_carrier_requires_explicit_backend: true
      steps:
        - step_id: pr-triage
          role_id: analyst
          runtime_role: business_analyst
          task_class: specification
          command_ref: agent-init-business-analyst
          lifecycle_hook_templates: [command_timing_summary]
          proof_gates:
            required_outputs: [pr_inventory, mergeability_matrix, recommended_disposition]
        - step_id: pr-ci-review
          role_id: tester
